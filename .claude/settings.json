{
  "permissions": {
    "allow": [
      "Bash(make check)",
      "Bash(make test)",
      "Bash(make format)",
      "Bash(make docs)",
      "Bash(make status)",
      "Bash(make status *)",
      "Bash(uv run pytest)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy)",
      "Bash(uv run mypy *)"
    ],
    "ask": [
      "Bash(*scripts/launch/tmux.sh*)",
      "Bash(*scripts/launch/slurm.sh*)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(make journal*)",
      "Bash(make setup*)",
      "Bash(*scripts/export_journal.py*)",
      "Bash(*scripts/setup.py*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./overleaf/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check.sh mark"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
