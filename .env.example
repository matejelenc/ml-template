# Copy to .env and fill in. .env is gitignored; never commit real values.
# Variable names only in this file.

# Where run folders are written on this server (default: runs/ in the repo).
RUNS_DIR=
# Where datasets live on this server (default: data/ in the repo).
DATA_DIR=

# Weights & Biases API key.
WANDB_API_KEY=
# Overleaf git token, used when pushing journal entries.
OVERLEAF_TOKEN=
