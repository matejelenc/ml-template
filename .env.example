# Copy to .env and fill in. .env is gitignored; never commit real values.
# Variable names only in this file.

# ===== Settings =====
# Ordinary per-server values. They are written into run records as they are.

# Where run folders are written on this server (default: runs/ in the repo).
RUNS_DIR=
# Where datasets live on this server (default: data/ in the repo).
DATA_DIR=

# Default settings file for the launchers: scripts/launch/servers/<name>.sh
LAUNCH_PROFILE=

# Weights & Biases: the project that runs are logged to.
WANDB_PROJECT=
# Optional: your W&B user or team (default: your own account).
WANDB_ENTITY=
# Optional: online (default), offline or disabled.
WANDB_MODE=

# Overleaf: the project's git URL (Menu > Git in Overleaf, without the "git clone" part).
# Used to push journal entries.
OVERLEAF_GIT_URL=

# ===== Secrets =====
# Keys, tokens and passwords. Put every secret in this section AND add its name to SECRETS.
#
# SECRETS is the list that counts: the values of the variables named in it are replaced by
# "<redacted>" in everything the code writes or uploads (run folders, logs, W&B, the
# journal). Nothing is guessed from names or from this heading, so a secret that is not
# named in SECRETS is not redacted. Names are separated by commas.
SECRETS=WANDB_API_KEY,OVERLEAF_TOKEN

# Weights & Biases API key (wandb.ai/authorize).
WANDB_API_KEY=
# Overleaf git token (Account settings > Git integration).
OVERLEAF_TOKEN=
